# Image versions (required)
BACKEND_VERSION=0.1.0
WEB_VERSION=0.1.0
STORE_VERSION=0.1.0

# Database
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=crm

# Security
# Use a random value with at least 64 characters.
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_64_CHARS_CHANGE_ME_JWT_SECRET_MIN_64_CHARS

# Optional client/public URLs (usually set by compose.client.yml in D4)
CORS_ORIGIN=
PUBLIC_BASE_URL=
