# Image versions (required)
BACKEND_VERSION=0.2.0
# GHCR image name under ghcr.io/<namespace>/ (default full monolith backend)
BACKEND_IMAGE_NAME=crm-backend-core
# Core-only API image (compose target core-runner): set to crm-core-api and match published digest.
# BACKEND_IMAGE_NAME=crm-core-api
#
# Separate outbound module image (compose.modules.outbound-sidecar.yml → service backend-outbound).
# OUTBOUND_MODULE_IMAGE_NAME=crm-module-outbound
# On full `backend`, set OUTBOUND_CRON_DISABLED=true when cron runs only in backend-outbound.
# OUTBOUND_CRON_DISABLED=
#
# Core API (crm-core-api) → outbound module HTTP reverse-proxy (same paths on upstream).
# OUTBOUND_UPSTREAM_URL=http://backend-outbound:3001
#
# Other optional module images (see compose.modules.*-sidecar.yml):
# GOOGLE_SHEET_MODULE_IMAGE_NAME=crm-module-google-sheet
# GOOGLE_SHEET_UPSTREAM_URL=http://backend-google-sheet:3001
# RINGOSTAT_MODULE_IMAGE_NAME=crm-module-ringostat
# RINGOSTAT_UPSTREAM_URL=http://backend-ringostat:3001
# BITRIX_MODULE_IMAGE_NAME=crm-module-bitrix
# BITRIX_UPSTREAM_URL=http://backend-bitrix:3001
# NP_MODULE_IMAGE_NAME=crm-module-np
# NP_UPSTREAM_URL=http://backend-np:3001
# FINANCE_MODULE_IMAGE_NAME=crm-module-finance
# FINANCE_UPSTREAM_URL=http://backend-finance:3001
# PLANNING_MODULE_IMAGE_NAME=crm-module-planning
# PLANNING_UPSTREAM_URL=http://backend-planning:3001
#
# When a module runs in a sidecar, disable its cron on full/core backend:
# FINANCE_CRON_DISABLED=true
# PLANNING_CRON_DISABLED=true
# NP_CRON_DISABLED=true
# BITRIX_CRON_DISABLED=true
# RINGOSTAT_CRON_DISABLED=true
# On core when NP is external: block in-process NP writes (optional):
# NP_WRITES_DISABLED=true
WEB_VERSION=0.2.0
STORE_VERSION=0.2.0

# Database
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=crm

# Security
# Use a random value with at least 64 characters.
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_64_CHARS_CHANGE_ME_JWT_SECRET_MIN_64_CHARS

# Optional client/public URLs (usually set by compose.client.yml in D4)
CORS_ORIGIN=
PUBLIC_BASE_URL=
