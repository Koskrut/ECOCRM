# Client-specific overrides for compose.client.yml.
# Append these values to the same .env that was created from .env.base.example.

# Public URLs
CORS_ORIGIN=https://crm.example.com,https://store.example.com
PUBLIC_BASE_URL=https://api.example.com

# Local bind addresses for reverse proxy.
# Keep 127.0.0.1 when nginx/caddy runs on the same host.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_PORT=3001
STORE_BIND_ADDRESS=127.0.0.1
STORE_PORT=3002

# Stable named volumes for this client.
POSTGRES_DATA_VOLUME=crm_postgres_data
LICENSE_CACHE_VOLUME=crm_license_cache

# License file mode (backend always reads entitlement from this file today).
# A real file is required for extension modules (e.g. ext.finance): payload.modules must list them.
# Pilot modules in the UI only toggle "enabled"; "licensed" comes from license.json + LICENSE_PUBLIC_KEY.
# If LICENSE_FILE_PATH_HOST points at /dev/null or a missing path, bank/payments APIs return 404.
LICENSE_MODE=file
LICENSE_FILE_PATH_HOST=/opt/crm/secrets/license.json
LICENSE_FILE_PATH=/run/secrets/license.json
# Public key in one line with \n escapes, or leave empty when using Control Plane mode.
LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nCHANGE_ME_LICENSE_PUBLIC_KEY\n-----END PUBLIC KEY-----

# Optional Control Plane license mode.
# LICENSE_MODE=server
# CONTROL_PLANE_URL=https://control-plane.example.com
# CONTROL_PLANE_TOKEN=CHANGE_ME_CONTROL_PLANE_TOKEN
# CONTROL_PLANE_INSTALLATION_ID=CHANGE_ME_INSTALLATION_ID
# LICENSE_CACHE_PATH=/data/license-cache.json
# LICENSE_PUBLIC_KEY_PEM=CHANGE_ME_BASE64_OR_PEM_PUBLIC_KEY

# One-click updates: compose.client.yml starts service `updater` automatically.
# Optional shared secret between backend and updater (leave empty for trusted internal network).
# UPDATER_AGENT_TOKEN=
# CRM_RELEASE_VERSION=0.2.84
# GIT_SHA=abc1234
# BUILD_TIME=2026-06-05T12:00:00Z
# IMAGE_TAG=ghcr.io/koskrut/crm-core-api:0.2.84
