# ============================================================
# Production .env for docker-compose (root of repo on server)
# Copy to .env and replace placeholders:
#   cp .env.production.example .env
#   nano .env
# ============================================================

# Required by docker-compose.prod.yml (PostgreSQL container)
POSTGRES_PASSWORD=ЗАМІНИТИ_НА_НАДІЙНИЙ_ПАРОЛЬ

# Ліцензія (обов'язково для extension-модулів: фінанси, telegram тощо)
# Бекенд бере entitlement лише з підписаного license.json: у payload.modules мають бути id модулів
# (наприклад ext.finance). Пілот-модулі в UI лише вмикають «enabled»; без запису в файлі модуль
# не «licensed» — банк/платежі дають 404. Якщо LICENSE_FILE_PATH_HOST=/dev/null або файлу немає —
# у контейнері немає реальної ліцензії, навіть якщо CP виглядає увімкненим.
# Шлях на хості (поза git), який монтується в backend read-only.
LICENSE_FILE_PATH_HOST=/opt/crm/secrets/license.json
# Шлях у контейнері (має відповідати docker-compose.prod.yml)
LICENSE_FILE_PATH=/run/secrets/license.json
# Публічний ключ в один рядок із \n
LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nЗАМІНИТИ_НА_КЛЮЧ\n-----END PUBLIC KEY-----

# Backend (DATABASE_URL задається в compose автоматично)
JWT_SECRET=ЗАМІНИТИ_НА_ДОВГУ_ВИПАДКОВУ_СТРОКУ

# CORS: усі браузерні Origin, з яких фронт звертається до API (через кому, без пробілів).
# Мінімум: CRM + Store. Додайте https://suprex.dental, якщо apex колись віддає сторінку без редиректу;
# при редиректі apex → www типовий Origin лише https://www.suprex.dental (apex у списку не заважає).
# За потреби залиште також IP-оригін для відладки, напр.: ,http://159.195.31.153:3000,http://159.195.31.153:3002
CORS_ORIGIN=https://crm.suprex.dental,https://www.suprex.dental,https://suprex.dental

# Публічний URL бекенда для webhook (Telegram, Ringostat, Bitrix)
PUBLIC_BASE_URL=https://api.suprex.dental

# Після зміни CORS_ORIGIN на сервері перезапустіть backend, щоб підхопити змінні:
#   docker compose -f docker-compose.prod.yml --env-file .env up -d backend

# Store: ownerId для замовлень з магазину (опційно; після seed взяти з лога STORE_OWNER_ID)
# STORE_OWNER_ID=

# --- Nova Poshta ---
NP_API_URL=https://api.novaposhta.ua/v2.0/json/
NP_API_KEY=ЗАМІНИТИ_НА_ВАШ_КЛЮЧ_НП
# NP_API_TIMEOUT_MS=30000

NP_SENDER_CITY_REF=ЗАМІНИТИ_REF_МІСТА
NP_SENDER_WAREHOUSE_REF=ЗАМІНИТИ_REF_ВІДДІЛЕННЯ
# Обовʼязково для створення ТТН (див. np-ttn.service): контрагент і контакт відправника в кабінеті НП
NP_SENDER_COUNTERPARTY_REF=ЗАМІНИТИ_REF_КОНТРАГЕНТА
NP_SENDER_CONTACT_REF=ЗАМІНИТИ_REF_КОНТАКТУ
NP_SENDER_FIRST_NAME=Імʼя
NP_SENDER_LAST_NAME=Прізвище
NP_SENDER_PHONE=380XXXXXXXXX

NP_DEFAULT_PAYER_TYPE=Recipient
NP_DEFAULT_PAYMENT_METHOD=Cash

# Фонові задачі (оновлення ТТН, синк довідників НП тощо) — на проді зазвичай true
CRON_ENABLED=true

# --- SMTP (листи з workflow, сповіщення) — за потреби «нової пошти» / SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Telegram (Inbox) — опційно ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# PUBLIC_BASE_URL задано вище (https://api.suprex.dental)
# STORE_TELEGRAM_BOT_USERNAME=
# TELEGRAM_LEAD_COMPANY_ID=
# OPENAI_API_KEY=

# --- Bitrix import (якщо запускаєте npm run bitrix:import на цьому хості) ---
# POSTGRES_PASSWORD вже є вище — скрипт збере DATABASE_URL для 127.0.0.1:5432.
# Якщо Bitrix MySQL через SSH-туннель: BITRIX_MYSQL_HOST=127.0.0.1, BITRIX_MYSQL_PORT=3307 та ін.
# BITRIX_MYSQL_HOST=127.0.0.1
# BITRIX_MYSQL_PORT=3307
# BITRIX_MYSQL_USER=
# BITRIX_MYSQL_PASSWORD=
# BITRIX_MYSQL_DATABASE=bitrix
# BITRIX_WEBHOOK_URL=https://...

# --- Privat24 / інше — за потреби з apps/backend/.env.example ---

# --- OSRM (visit route km / map polylines; internal Docker network) ---
# OSRM_BASE_URL=http://osrm:5000
# ROUTING_PROFILE=car
