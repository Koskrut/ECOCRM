# Gateway HTTP
PORT=3100
LOG_LEVEL=info

# mock | kyivstar_openai
GATEWAY_PROVIDER_MODE=mock
REAL_MODE_ENABLED=false
REAL_MODE_PERCENT=0

# Must match CRM IntegrationSetting OUTBOUND_VOICE apiToken (Bearer)
GATEWAY_API_TOKEN=

# Optional: if set, GET /v1/sessions/* requires this OR GATEWAY_API_TOKEN
GATEWAY_DEBUG_TOKEN=

# Must match CRM webhook secret (header value for x-outbound-voice-secret)
CRM_WEBHOOK_SECRET=

# Outbound webhooks to CRM
CRM_WEBHOOK_TIMEOUT_MS=15000
CRM_WEBHOOK_RETRY_COUNT=4
CRM_WEBHOOK_RETRY_DELAY_MS=500
CRM_WEBHOOK_MAX_BACKOFF_MS=8000

# OpenAI (integration point — not used in mock MVP)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy
OPENAI_REALTIME_WS_URL=wss://api.openai.com/v1/realtime
OPENAI_REALTIME_SAMPLE_RATE_HZ=16000

# Kyivstar control plane / SIP integration
# Before production canary: fill docs/KYIVSTAR_CONTRACT_MATRIX.md from vendor truth; defaults below are placeholders.
KYIVSTAR_API_BASE_URL=
KYIVSTAR_API_TOKEN=
# http (default) = REST control plane; synthetic = local timers only for dev — not for pilot
KYIVSTAR_CONTROL_PLANE_MODE=http
KYIVSTAR_HTTP_TIMEOUT_MS=15000
KYIVSTAR_HTTP_OUTBOUND_PATH=/v1/outbound/calls
KYIVSTAR_HTTP_STATUS_PATH_TEMPLATE=/v1/calls/{callId}/status
KYIVSTAR_HTTP_HANGUP_PATH_TEMPLATE=/v1/calls/{callId}/hangup
KYIVSTAR_HTTP_HANGUP_METHOD=POST
KYIVSTAR_HTTP_MEDIA_PATH_TEMPLATE=/v1/calls/{callId}/media
# bearer (default) | api_key — if api_key, token is sent as KYIVSTAR_HTTP_AUTH_HEADER_NAME
KYIVSTAR_HTTP_AUTH_STYLE=bearer
KYIVSTAR_HTTP_AUTH_HEADER_NAME=X-Api-Key

# First live pilot: require destination in whitelist (digits-only match). Off by default.
CANARY_LIVE_CALLS_ENABLED=false
# Comma-separated E.164, e.g. +380501112233,+380501112234
CANARY_ALLOWED_E164=

# SIP trunk / media alignment — included in outbound JSON when set; not used for raw SIP by gateway HTTP client
KYIVSTAR_SIP_REALM=
KYIVSTAR_SIP_USER=
KYIVSTAR_SIP_PASSWORD=
KYIVSTAR_SIP_PROXY=

# RTP/media bridge
RTP_BIND_ADDRESS=0.0.0.0
# Public IP/host sent to sip-adapter POST /media (e.g. 159.195.31.153 on VPS)
RTP_ADVERTISE_ADDRESS=0.0.0.0
RTP_PORT_START=30000
RTP_PORT_END=30999
CALL_MAX_DURATION_SEC=180
CALL_MAX_TURNS=6
#
# CRM alignment (no CRM code changes):
# - apiBaseUrl + /v1/outbound/calls, Bearer = GATEWAY_API_TOKEN (same as CRM apiToken)
# - Response must include session_id = externalSessionId for default responseSessionIdKeys
# - Webhooks: header webhookSecretHeader value = CRM_WEBHOOK_SECRET (= CRM webhook secret)
# - crmContext.mockOutcome selects mock branch: default | no_answer | price_issue | competitor | catalog_requested | callback_requested | do_not_call | transferred
