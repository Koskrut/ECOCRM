# Gateway HTTP
PORT=3100
LOG_LEVEL=info

# mock | kyivstar_openai (MVP: both use mock lifecycle; kyivstar_openai label only — real transport is stub)
GATEWAY_PROVIDER_MODE=mock

# Must match CRM IntegrationSetting OUTBOUND_VOICE apiToken (Bearer)
GATEWAY_API_TOKEN=

# Optional: if set, GET /v1/sessions/* requires this OR GATEWAY_API_TOKEN
GATEWAY_DEBUG_TOKEN=

# Must match CRM webhook secret (header value for x-outbound-voice-secret)
CRM_WEBHOOK_SECRET=

# Outbound webhooks to CRM
CRM_WEBHOOK_TIMEOUT_MS=15000
CRM_WEBHOOK_RETRY_COUNT=4
CRM_WEBHOOK_RETRY_DELAY_MS=500
CRM_WEBHOOK_MAX_BACKOFF_MS=8000

# OpenAI (integration point — not used in mock MVP)
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
OPENAI_REALTIME_VOICE=alloy

# Kyivstar HTTP API (integration point — stub in MVP)
KYIVSTAR_API_BASE_URL=
KYIVSTAR_API_TOKEN=
# Future SIP/media config — not wired in MVP:
# KYIVSTAR_SIP_REALM=
# KYIVSTAR_SIP_USER=
#
# CRM alignment (no CRM code changes):
# - apiBaseUrl + /v1/outbound/calls, Bearer = GATEWAY_API_TOKEN (same as CRM apiToken)
# - Response must include session_id = externalSessionId for default responseSessionIdKeys
# - Webhooks: header webhookSecretHeader value = CRM_WEBHOOK_SECRET (= CRM webhook secret)
# - crmContext.mockOutcome selects mock branch: default | no_answer | price_issue | competitor | catalog_requested | callback_requested | do_not_call | transferred
