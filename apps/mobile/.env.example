# Optional: one-time seed for API URL when device storage is empty.
# Without this (production multi-client APK), the app asks for the CRM URL on first launch.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Required for interactive Google Maps on Android (native MapView).
# Also set the same value as an EAS secret for preview/production builds.
# Without it, the map screen uses a static preview to avoid process crash.
# GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=