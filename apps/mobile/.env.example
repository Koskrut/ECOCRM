# Optional: one-time seed for API URL when device storage is empty.
# Without this (production multi-client APK), the app asks for the CRM URL on first launch.
EXPO_PUBLIC_API_URL=http://localhost:3001

# Native Google Maps (Android MapView / optional iOS Google provider).
# REQUIRED for interactive maps — must be present at EAS *native* build time so
# app.config.js can write android.config.googleMaps.apiKey → AndroidManifest
# meta-data com.google.android.geo.API_KEY. OTA/JS-only updates are NOT enough.
#
# Prefer a project secret (not committed):
#   eas secret:create --name GOOGLE_MAPS_API_KEY --value 'AIza…' --scope project
# Google Cloud: enable "Maps SDK for Android"; restrict key to package
# dental.suprex.crm.manager + SHA-1 (EAS/Play App Signing).
#
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY is also accepted by app.config.js as a fallback
# for the native key, and is used at runtime for Static Maps URLs when the CRM
# settings key is missing. Without any native key, the app shows static preview
# and will not mount MapView (avoids process kill on Android).
# GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
