{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "autoIncrement": true,
      "node": "24.11.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_FIELD_TRACKING_MODE": "legacy_expo"
      }
    },
    "preview-native": {
      "extends": "preview",
      "distribution": "internal",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_FIELD_TRACKING_MODE": "native_android"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
