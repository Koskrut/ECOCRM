model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  companyId   String?

  // старое поле (если используешь как "клиент заказа")
  clientId String?

  // поле — контакт для ТТН
  contactId String?

  ownerId            String
  /**
   * @deprecated Phase 7: use orderStage. Kept for backward compat; no longer written.
   */
  status             OrderStatus?
  currency           String
  subtotalAmount     Float
  discountAmount     Float
  totalAmount        Float
  paidAmount         Float
  debtAmount         Float
  /// Available overpayment after return / overpay (visible, transferable).
  creditAmount       Float    @default(0)
  comment            String?
  legacySource       String?
  legacyId           Int?
  legacyRaw          Json?
  syncedAt           DateTime?
  /// Last NP status sync (cron bulk or manual); drives fair selection order for bulk sync.
  lastNpStatusSyncAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  deliveryMethod     DeliveryMethod?
  paymentMethod      PaymentMethod?
  /**
   * Банковский счёт (ФОП) при оплате FOP.
   */
  bankAccountId      String?
  /**
   * Склад отгрузки.
   */
  warehouseId        String?
  /**
   * Bitrix UF_CRM_1753788124915 — Документы (Да/нет).
   */
  documentsRequested Boolean?
  paymentType        PaymentType?
  deliveryData       Json?
  orderSource        OrderSource     @default(CRM)
  /**
   * Номер и дата счёта (из 1С).
   */
  invoiceNumber      String?
  invoiceDate        DateTime?
  /**
   * Номер и дата РН / расходной накладной (из 1С).
   */
  waybillNumber      String?
  waybillDate        DateTime?
  /**
   * Курс сделки для таблицы/документов.
   */
  exchangeRate       Float?

  // --- New order model (Phase 1): keep status for compatibility ---
  orderStage             OrderStage?
  deliveryStatus         DeliveryStatus?
  financialStatus        OrderFinancialStatus?
  paymentDueDate         DateTime?
  /// Phase 5: sum of amounts from closed returns (reduces effective total for debt calc).
  returnAdjustmentAmount Float                 @default(0)
  /// FX variance written off (reduces debt without increasing paidAmount).
  fxWriteOffAmount       Float                 @default(0)
  fxWriteOffNote         String?
  fxWriteOffAt           DateTime?
  fxWriteOffByUserId     String?

  /// Backorder / stock split: child order points to the order it was split from.
  parentOrderId String?
  parentOrder   Order?  @relation("OrderSplit", fields: [parentOrderId], references: [id], onDelete: SetNull)
  childOrders   Order[] @relation("OrderSplit")
  replacementForReturns OrderReturn[] @relation("OrderReplacement")

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Order.clientId -> Contact
  client Contact? @relation("OrderClient", fields: [clientId], references: [id], onDelete: SetNull)

  // Order.contactId -> Contact (для ТТН)
  contact Contact? @relation("OrderContact", fields: [contactId], references: [id], onDelete: SetNull)

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  activities        Activity[]
  tasks             Task[]
  convertedFromLead Lead?

  ttns              OrderTtn[]
  shipments         Shipment[]
  payments          Payment[]
  paymentRequests   PaymentRequest[]
  returns           OrderReturn[]
  balanceTransactions ClientBalanceTransaction[]
  productionBatches ProductionBatch[]
  reservations      MaterialReservation[]
  weeklyPlanItems   WeeklyPlanItem[]
  riskDecisions     RiskDecision[]

  fxWriteOffBy User? @relation("OrderFxWriteOffBy", fields: [fxWriteOffByUserId], references: [id], onDelete: SetNull)

  @@unique([legacySource, legacyId])
  @@index([companyId])
  @@index([clientId])
  @@index([contactId])
  @@index([ownerId])
  @@index([bankAccountId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderSource])
  @@index([orderStage])
  @@index([financialStatus])
  @@index([lastNpStatusSyncAt])
  @@index([parentOrderId])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String?
  productNameSnapshot String? // название из Bitrix при отсутствии Product в ECOCRM
  qty                 Int
  price               Float
  discountPercent     Int     @default(0)
  lineTotal           Float

  // кеш для частичных отправок
  qtyShipped Int @default(0)

  legacySource String?
  legacyId     Int?
  legacyRaw    Json?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  // связи с конкретными ТТН (частичная отгрузка)
  ttnItems      OrderTtnItem[]
  shipmentItems ShipmentItem[]
  returnItems   OrderReturnItem[]

  @@unique([orderId, productId], name: "orderId_productId")
  @@unique([legacySource, legacyId])
  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  /**
   * Phase 7: primary axis for timeline; set when recording stage change.
   */
  fromOrderStage OrderStage?
  toOrderStage   OrderStage?
  changedBy      String
  reason         String?
  createdAt      DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([toOrderStage])
  @@index([createdAt])
}

model OrderTtn {
  id         String  @id @default(cuid())
  /// @deprecated use shipmentId as the source of truth
  orderId    String?
  shipmentId String?
  carrier    Carrier @default(NOVA_POSHTA)

  documentNumber String
  documentRef    String?

  statusCode String?
  statusText String?

  cost                  Float?
  estimatedDeliveryDate DateTime?

  payloadSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // ✅ позиции, которые уехали в этой ТТН
  items OrderTtnItem[]

  @@index([orderId])
  @@index([shipmentId])
  @@index([documentNumber])
  @@index([statusCode])
  @@index([updatedAt])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  contactId         String?
  carrier           Carrier        @default(NOVA_POSHTA)
  status            ShipmentStatus @default(DRAFT)
  recipientSnapshot Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contact Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items   ShipmentItem[]
  ttns    OrderTtn[]

  @@index([orderId])
  @@index([contactId])
  @@index([status])
  @@index([carrier])
}

model ShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  orderItemId String
  qty         Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  shipment  Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, orderItemId])
  @@index([shipmentId])
  @@index([orderItemId])
}

//
// ✅ строки отгрузки по TTN (частичная отгрузка)
//
model OrderTtnItem {
  id          String @id @default(cuid())
  ttnId       String
  orderItemId String
  qtyShipped  Int

  ttn       OrderTtn  @relation(fields: [ttnId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([ttnId, orderItemId])
  @@index([ttnId])
  @@index([orderItemId])
}

/// Inbound return shipment grouped by TTN (may span multiple orders).
model ReturnPackage {
  id            String              @id @default(cuid())
  ttnNumber     String              @unique
  carrier       Carrier             @default(NOVA_POSHTA)
  ttnStatusCode String?
  ttnStatusText String?
  ttnSyncedAt   DateTime?
  contactId     String?
  note          String?
  warehouseId   String?
  status        ReturnPackageStatus @default(IN_TRANSIT_BACK)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  contact   Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  returns   OrderReturn[]

  @@index([status])
  @@index([contactId])
  @@index([ttnSyncedAt])
  @@index([warehouseId])
}

/// Return request for an order (Phase 1: new model).
model OrderReturn {
  id          String       @id @default(cuid())
  orderId     String
  status      ReturnStatus
  reason      ReturnReason @default(CUSTOMER_CHANGE)
  replacementMode ReplacementMode?
  replacementOrderId String?
  inboundDoneAt DateTime?
  outboundDoneAt DateTime?
  inboundWaivedAt DateTime?
  inboundWaiveReason String?
  outboundWaivedAt DateTime?
  outboundWaiveReason String?
  requestedAt DateTime     @default(now())
  closedAt    DateTime?
  settlementType   ReturnSettlementType?
  creditAmount     Float?
  refundAmount     Float?
  settledAt        DateTime?
  settledByUserId  String?
  returnPackageId  String?
  warehouseId      String?
  itemsPending     Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  replacementOrder Order? @relation("OrderReplacement", fields: [replacementOrderId], references: [id], onDelete: SetNull)
  returnPackage ReturnPackage? @relation(fields: [returnPackageId], references: [id], onDelete: SetNull)
  warehouse Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items OrderReturnItem[]
  balanceTransactions ClientBalanceTransaction[]

  settledBy User? @relation("OrderReturnSettledBy", fields: [settledByUserId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([returnPackageId])
  @@index([replacementOrderId])
  @@index([reason])
  @@index([warehouseId])
}

model OrderReturnItem {
  id            String   @id @default(cuid())
  orderReturnId String
  orderItemId   String
  qtyReturned   Int
  actualProductId String?
  disposition   ReturnItemDisposition @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orderReturn OrderReturn @relation(fields: [orderReturnId], references: [id], onDelete: Cascade)
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  actualProduct Product? @relation("ReturnItemActualProduct", fields: [actualProductId], references: [id], onDelete: SetNull)

  @@unique([orderReturnId, orderItemId])
  @@index([orderReturnId])
  @@index([orderItemId])
  @@index([actualProductId])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  title      String?
  body       String
  occurredAt DateTime?
  pinnedAt   DateTime?
  createdBy  String
  createdAt  DateTime     @default(now())

  orderId   String?
  contactId String?
  companyId String?
  leadId    String?
  callId    String? @unique

  legacySource String?
  legacyId     Int?

  order             Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visit             Visit? // back-relation: visit that uses this timeline activity (one-to-one)
  call              Call?              @relation("ActivityCall", fields: [callId], references: [id], onDelete: SetNull)
  manualCallSession ManualCallSession?

  @@unique([legacySource, legacyId])
  @@index([orderId])
  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([createdAt])
  @@index([callId])
}

model AuditLog {
  id            String      @id @default(cuid())
  entityType    String
  entityId      String
  action        AuditAction
  changedBy     String
  changedByRole String?
  before        Json?
  after         Json?
  diff          Json?
  context       Json?
  createdAt     DateTime    @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([changedBy, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}

model UserNotification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String?
  entityType String?
  entityId   String?
  meta       Json?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model UserNotificationPreference {
  userId   String
  type     NotificationType
  inApp    Boolean @default(true)
  browser  Boolean @default(false)
  telegram Boolean @default(false)
  mobile   Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model UserPushDevice {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String
  deviceId   String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  assigneeId  String
  /**
   * Хто створив задачу в CRM (видимість для MANAGER: assignee або creator).
   */
  createdById String?
  contactId   String?
  companyId   String?
  leadId      String?
  orderId     String?
  /**
   * Задача «Перезвонить» по пропущенному звонку — одна на Call (идемпотентность ingest).
   */
  callId      String?    @unique
  title       String
  body        String?
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  legacySource String?
  legacyId     Int?

  assignee  User     @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  createdBy User?    @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  call      Call?    @relation("MissedCallTask", fields: [callId], references: [id], onDelete: SetNull)
  dailyWorkPlanItems DailyWorkPlanItem[]

  @@unique([legacySource, legacyId])
  @@index([assigneeId, status])
  @@index([createdById])
  @@index([dueAt])
  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([orderId])
}

// ===== NP Catalog cache (daily sync) =====

model NpCity {
  ref                       String   @id
  description               String
  area                      String?
  areaDescription           String?
  region                    String?
  settlementTypeDescription String?
  isActive                  Boolean  @default(true)
  updatedAt                 DateTime @updatedAt

  @@index([description])
}

model NpWarehouse {
  ref             String   @id
  cityRef         String
  cityName        String
  number          String?
  description     String
  shortAddress    String?
  typeOfWarehouse String?
  isPostomat      Boolean  @default(false)
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt

  @@index([cityRef])
  @@index([description])
  @@index([isPostomat])
}

model NpStreet {
  ref       String   @id
  cityRef   String
  street    String
  updatedAt DateTime @updatedAt

  @@index([cityRef])
  @@index([street])
}

// ===== NP Sender cache (singleton) =====

model NpSenderSettings {
  id String @id @default("default")

  cityRef      String
  warehouseRef String

  counterpartyRef  String
  contactPersonRef String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===== System settings (key-value) =====

model SystemSetting {
  id        String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model Dictionary {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  system      Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  items DictionaryItem[]
  customFields CustomFieldDefinition[]

  @@index([system])
  @@index([isActive])
  @@index([deletedAt])
}

model DictionaryItem {
  id           String    @id @default(cuid())
  dictionaryId String
  key          String
  label        String
  value        String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  customFieldValues CustomFieldValue[]

  @@unique([dictionaryId, key])
  @@index([dictionaryId, sortOrder])
  @@index([dictionaryId, isActive])
  @@index([deletedAt])
}

model CustomFieldDefinition {
  id           String                @id @default(cuid())
  entityType   CustomFieldEntityType
  key          String
  label        String
  description  String?
  type         CustomFieldType
  required     Boolean               @default(false)
  isActive     Boolean               @default(true)
  system       Boolean               @default(false)
  dictionaryId String?
  settings     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  dictionary Dictionary?          @relation(fields: [dictionaryId], references: [id], onDelete: SetNull)
  options    CustomFieldOption[]
  values     CustomFieldValue[]
  layoutFields LayoutField[]

  @@unique([entityType, key])
  @@index([entityType, isActive])
  @@index([dictionaryId])
  @@index([deletedAt])
}

model CustomFieldOption {
  id           String    @id @default(cuid())
  definitionId String
  key          String
  label        String
  value        String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, key])
  @@index([definitionId, sortOrder])
  @@index([definitionId, isActive])
  @@index([deletedAt])
}

model CustomFieldValue {
  id               String                @id @default(cuid())
  definitionId     String
  entityType       CustomFieldEntityType
  entityId         String
  valueString      String?
  valueNumber      Float?
  valueBoolean     Boolean?
  valueDate        DateTime?
  valueJson        Json?
  dictionaryItemId String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  definition     CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  dictionaryItem DictionaryItem?        @relation(fields: [dictionaryItemId], references: [id], onDelete: SetNull)

  @@unique([definitionId, entityId])
  @@index([entityType, entityId])
  @@index([definitionId, valueString])
  @@index([definitionId, valueNumber])
  @@index([definitionId, valueBoolean])
  @@index([definitionId, valueDate])
  @@index([dictionaryItemId])
}

model LayoutDefinition {
  id          String                @id @default(cuid())
  entityType  CustomFieldEntityType
  type        LayoutType
  key         String
  name        String
  description String?
  isDefault   Boolean               @default(false)
  isActive    Boolean               @default(true)
  settings    Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  deletedAt   DateTime?

  sections LayoutSection[]

  @@unique([entityType, type, key])
  @@index([entityType, type, isActive])
  @@index([isDefault])
  @@index([deletedAt])
}

model LayoutSection {
  id          String    @id @default(cuid())
  layoutId    String
  key         String
  title       String
  description String?
  sortOrder   Int       @default(0)
  columns     Int       @default(1)
  isActive    Boolean   @default(true)
  settings    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  layout LayoutDefinition @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  fields LayoutField[]

  @@unique([layoutId, key])
  @@index([layoutId, sortOrder])
  @@index([layoutId, isActive])
  @@index([deletedAt])
}

model LayoutField {
  id                      String   @id @default(cuid())
  sectionId               String
  key                     String
  fieldKey                String?
  customFieldDefinitionId String?
  label                   String?
  sortOrder               Int      @default(0)
  required                Boolean  @default(false)
  readonly                Boolean  @default(false)
  hidden                  Boolean  @default(false)
  width                   Int?
  settings                Json?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  deletedAt               DateTime?

  section               LayoutSection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  customFieldDefinition CustomFieldDefinition? @relation(fields: [customFieldDefinitionId], references: [id], onDelete: SetNull)

  @@unique([sectionId, key])
  @@index([sectionId, sortOrder])
  @@index([customFieldDefinitionId])
  @@index([deletedAt])
}

model WorkflowRule {
  id                         String                @id @default(cuid())
  key                        String                @unique
  name                       String
  description                String?
  entityType                 CustomFieldEntityType?
  triggerType                WorkflowTriggerType
  triggerConfig              Json?
  conditions                 Json
  actions                    Json
  rateLimitPerEntityPerHour  Int                   @default(10)
  isActive                   Boolean               @default(false)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  deletedAt                  DateTime?

  executions WorkflowExecutionLog[]

  @@index([entityType, triggerType])
  @@index([isActive])
  @@index([deletedAt])
}

model WorkflowExecutionLog {
  id            String                  @id @default(cuid())
  ruleId        String
  entityType    CustomFieldEntityType?
  entityId      String?
  triggerType   WorkflowTriggerType
  status        WorkflowExecutionStatus @default(PENDING)
  correlationId String?
  triggerPayload Json?
  actionsResult Json?
  error         String?
  startedAt     DateTime                @default(now())
  finishedAt    DateTime?
  createdAt     DateTime                @default(now())

  rule WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([correlationId])
  @@index([status, createdAt])
}

/// Generic CSV import job (core data onboarding).
model DataImportJob {
  id           String   @id @default(cuid())
  targetEntity String
  status       String   @default("draft")
  fileName     String?
  summary      Json?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User @relation("DataImportJobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([createdById])
  @@index([status])
  @@index([targetEntity])
}

/// User-defined entity type (dynamic CRM extension).
model CustomEntityDefinition {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  pluralName  String?
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  records CustomEntityRecord[]

  @@index([isActive])
  @@index([deletedAt])
}

model CustomEntityRecord {
  id           String   @id @default(cuid())
  definitionId String
  data         Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  definition CustomEntityDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
}

model KitBom {
  id            String   @id @default(cuid())
  kitProductId  String
  revision      Int
  effectiveFrom DateTime @default(now())
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  kitProduct Product      @relation("KitBomKit", fields: [kitProductId], references: [id], onDelete: Cascade)
  lines      KitBomLine[]

  @@unique([kitProductId, revision])
  @@index([kitProductId])
  @@index([kitProductId, isActive])
}

model KitBomLine {
  id                 String   @id @default(cuid())
  bomId              String
  componentProductId String
  qtyPerKit          Decimal  @db.Decimal(18, 4)
  scrapPct           Decimal? @db.Decimal(5, 2)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  bom       KitBom  @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component Product @relation("KitBomComponent", fields: [componentProductId], references: [id], onDelete: Restrict)

  @@unique([bomId, componentProductId])
  @@index([bomId])
  @@index([componentProductId])
}

model InventorySnapshot {
  id           String                  @id @default(cuid())
  source       InventorySnapshotSource @default(FILE_UPLOAD)
  status       InventorySnapshotStatus @default(STAGED)
  note         String?
  importedAt   DateTime                @default(now())
  importedById String
  postedAt     DateTime?
  postedById   String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  importedBy   User                    @relation("InventorySnapshotImportedBy", fields: [importedById], references: [id], onDelete: Restrict)
  postedBy     User?                   @relation("InventorySnapshotPostedBy", fields: [postedById], references: [id], onDelete: SetNull)
  lines        InventorySnapshotLine[]
  packingLists PackingList[]

  @@index([status, importedAt])
  @@index([importedById])
}

model InventorySnapshotLine {
  id           String   @id @default(cuid())
  snapshotId   String
  warehouseId  String?
  productId    String?
  skuRaw       String
  qty          Int
  warehouseRaw String?
  createdAt    DateTime @default(now())

  snapshot  InventorySnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  warehouse Warehouse?        @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([snapshotId])
  @@index([warehouseId])
  @@index([productId])
  @@index([skuRaw])
