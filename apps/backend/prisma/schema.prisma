  NEW
  IN_PROGRESS
  PROCESSED
}

enum LeadSource {
  FACEBOOK
  TELEGRAM
  INSTAGRAM
  WEBSITE
  RINGOSTAT
  OTHER
  META
}

enum LeadChannel {
  FB_LEAD_ADS
  IG_LEAD_ADS
  FB_DM
  IG_DM
}

enum LeadEventType {
  CREATED
  UPDATED
  ASSIGNED
  NOTE
  CONTACTED
  STATUS_CHANGED
  DUPLICATE_MERGED
}

enum LeadIdentityType {
  PHONE
  EMAIL
  META_LEAD_ID
  IG_PROFILE_ID
  FB_PROFILE_ID
}

enum BankProvider {
  PRIVAT24
  UPC
}

enum BankTransactionMatchStatus {
  UNMATCHED
  NEEDS_REVIEW
  AUTO_MATCHED
  MATCHED
}

enum TransactionDirection {
  IN
  OUT
}

enum PaymentSourceType {
  BANK
  CASH
}

enum PaymentStatus {
  PENDING
  COMPLETED
  VOIDED
}

enum OrderPaymentStatus {
  UNPAID
