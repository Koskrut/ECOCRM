  config          Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  attempts OutboundCallAttempt[]

  @@index([isActive])
  @@index([targetType])
}

model OutboundCallAttempt {
  id                   String                @id @default(cuid())
  campaignId           String
  targetType           OutboundTargetType
  leadId               String?
  contactId            String?
  companyId            String?
  phoneNormalized      String
  scenarioCode         String
  scenarioVersion      String
  status               OutboundAttemptStatus @default(PENDING)
  provider             String?
  providerSessionId    String?               @unique
  /**
   * Gateway/external session id when different from providerSessionId
   */
  externalSessionId    String?
  callId               String?               @unique
  scheduledAt          DateTime?
  lastError            String?
  transcript           String?               @db.Text
  summary              String?               @db.Text
  outcome              Json?
  /**
   * Idempotent processing of final provider webhook delivery
   */
  webhookProcessedId   String?               @unique
  /**
   * e.g. HTTP_OUTBOUND_VOICE, KYIVSTAR_OPENAI_GATEWAY, STUB
   */
