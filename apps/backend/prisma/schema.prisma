  DEGREASE
  QC
  PACK
  TRANSFER
}

enum PlanningItemType {
  QC_QUEUE
  PACK_QUEUE
  LAUNCH_LIST
}

// --- MODELS ---

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  /** Lowercase login handle; unique. Used when signing in without full email. */
  username       String?   @unique
  fullName       String
  passwordHash   String
  role           UserRole  @default(MANAGER)
  isActive       Boolean   @default(true)
  telegramUserId String?   @unique
  telegramChatId String?   @unique
  legacySource   String?
  legacyId       Int?
  legacyRaw      Json?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /**
   * Руководитель (для LEAD-иерархии и фильтрации визитов).
   */
  leadId      String?
  lead        User?   @relation("UserHierarchy", fields: [leadId], references: [id], onDelete: SetNull)
  teamMembers User[]  @relation("UserHierarchy")

  tasksCreated Task[] @relation("TaskCreatedBy")

  /**
   * Начало/конец дневного маршрута визитов (якоря для Google Maps).
   */
  routeStartLat   Float?
  routeStartLng   Float?
  routeEndLat     Float?
  routeEndLng     Float?
  routeStartLabel String?
  routeEndLabel   String?

  contacts                   Contact[]
  leads                      Lead[]
  orders                     Order[]
  payments                   Payment[]
  paymentRequestsCreated     PaymentRequest[]    @relation("PaymentRequestCreatedBy")
  visits                     Visit[]
  routePlans                 RoutePlan[]
  routeSessions              RouteSession[]
  assignedConversations      Conversation[]
  outboundMessages           Message[]
  tasks                      Task[]
  companies                  Company[]
  importedInventorySnapshots InventorySnapshot[] @relation("InventorySnapshotImportedBy")
  postedInventorySnapshots   InventorySnapshot[] @relation("InventorySnapshotPostedBy")
  callQueueItems             CallQueueItem[]
  manualCallSessions         ManualCallSession[]
  rbacAssignments            RbacUserRoleAssignment[]
  dataImportJobsCreated      DataImportJob[]           @relation("DataImportJobCreatedBy")
  fieldProfile               UserFieldProfile?
  fieldShifts                FieldShift[]
  fuelDayReports             FuelDayReport[]

  @@unique([legacySource, legacyId])
  @@index([leadId])
}

model RbacRole {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  system      Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RbacRolePermission[]
  assignments RbacUserRoleAssignment[]

  @@index([system])
  @@index([isActive])
  @@index([deletedAt])
}

model RbacPermission {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  category    String?
  system      Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RbacRolePermission[]

  @@index([category])
  @@index([system])
  @@index([isActive])
  @@index([deletedAt])
}

model RbacRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RbacUserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserTelegramLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String    @id @default(cuid())
  name          String
  edrpou        String?
  taxId         String?
  phone         String?
  address       String?
  lat           Float?
  lng           Float?
  googlePlaceId String?
  legacySource  String?
  legacyId      Int?
  legacyRaw     Json?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ownerId       String?

  owner              User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts           Contact[]
  orders             Order[]
  activities         Activity[]
  leads              Lead[]
  payments           Payment[]
  visits             Visit[]
  tasks              Task[]
  changeHistory      CompanyChangeHistory[]
  callQueueItems     CallQueueItem[]
  manualCallSessions ManualCallSession[]

  @@unique([legacySource, legacyId])
  @@index([ownerId])
}

model CompanyChangeHistory {
  id        String   @id @default(cuid())
  companyId String
  changedBy String?
  action    String // CREATED | UPDATED
  payload   Json? // e.g. [{ "field": "name", "oldValue": "x", "newValue": "y" }]
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model Contact {
  id                  String    @id @default(cuid())
  ownerId             String?
  companyId           String?
  firstName           String
  lastName            String
  middleName          String?
  phone               String
  phoneNormalized     String? // цифры телефона для проверки уникальности по всей базе
  email               String?
  position            String?
  address             String?
  lat                 Float?
  lng                 Float?
  googlePlaceId       String?
  isPrimary           Boolean   @default(false)
  /**
   * Код 1С (импорт из Bitrix UF_CRM_1772007718612).
   */
  externalCode        String?
  /**
   * Как выводить на документ (счёт/РН): напр. «ФОП Петров Петр» при контакте Иванов Иван.
   */
  documentDisplayName String?
  /**
   * Область (Bitrix UF_CRM_1753079162490; fallback UF_CRM_1753079192866).
   */
  region              String?
  /**
   * Адрес (инфо) — строка из Bitrix ADDRESS.
   */
  addressInfo         String?
  /**
   * Город (Bitrix UF_CRM_1753079682882).
   */
  city                String?
  /**
   * Тип клиента: врач/техник (Bitrix UF_CRM_1756361960817).
   */
  clientType          String?
  /**
   * Статус клієнта (Bitrix UF_CRM_1755068668186).
   */
  status              String?
  /**
   * Відмова від маркетингових/AI дзвінків (outbound compliance).
   */
  marketingCallOptOut Boolean   @default(false)
  nextActionType      String?
  nextActionAt        DateTime?
  nextActionNote      String?
  clientStage         String?
  legacySource        String?
  legacyId            Int?
  legacyRaw           Json?
  syncedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // связь для Order.clientId (старое поле clientId в Order)
  ordersAsClient Order[] @relation("OrderClient")

  // связь для Order.contactId (поле для ТТН)
  ordersAsContact Order[] @relation("OrderContact")

  // профили доставки НП (несколько на контакт)
  shippingProfiles ContactShippingProfile[]
  phones           ContactPhone[]

  activities           Activity[]
  leads                Lead[]
  payments             Payment[]
  visits               Visit[]
  telegramAccounts     TelegramAccount[]
  conversations        Conversation[]
  tasks                Task[]
  customer             Customer?
  outboundCallAttempts OutboundCallAttempt[]
  shipments            Shipment[]
  changeHistory        ContactChangeHistory[]
  callQueueItems       CallQueueItem[]
  manualCallSessions   ManualCallSession[]

  @@unique([phoneNormalized])
  @@unique([legacySource, legacyId])
  @@index([companyId])
  @@index([ownerId])
}

model ContactChangeHistory {
  id        String   @id @default(cuid())
  contactId String
  changedBy String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

model Customer {
  id           String   @id @default(cuid())
  contactId    String   @unique
  email        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contact                 Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  carts                   Cart[]
  storePasswordResetCodes StorePasswordResetCode[]

  @@index([contactId])
}

model StorePasswordResetCode {
  id         String   @id @default(cuid())
  customerId String
  code       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Visit {
  id             String         @id @default(cuid())
  companyId      String?
  contactId      String?
  ownerId        String
  title          String?
  phone          String?
  addressText    String?
  lat            Float?
  lng            Float?
  locationSource LocationSource @default(NONE)
  radiusM        Int            @default(100)
  status         VisitStatus    @default(PLANNED_UNASSIGNED)
  startsAt       DateTime?
  endsAt         DateTime?
  durationMin    Int            @default(60)
  note           String?
  /**
   * Цель встречи (при постановке в план).
   */
  purpose        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  startedAt      DateTime?
  completedAt    DateTime?
  outcome        VisitOutcome?
  resultNote     String?
  nextActionAt   DateTime?
  nextActionNote String?
  activityId     String?       @unique // timeline activity: "план" → updated to result when completed

  /** Итог GPS-проверки при последнем START визита. */
  startGpsVerification VisitGpsVerification?
  /** Итог GPS-проверки при последнем COMPLETE визита. */
  completeGpsVerification VisitGpsVerification?

  company                Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact                Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner                  User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  activity               Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  routeStops             RouteStop[]
  routeSessionsAsCurrent RouteSession[]
  visitGpsEvents         VisitGpsEvent[]

  @@index([ownerId, status])
  @@index([ownerId, startsAt])
  @@index([companyId])
  @@index([contactId])
}

model VisitGpsEvent {
  id                 String               @id @default(cuid())
  visitId            String
  kind               VisitGpsEventKind
  lat                Float?
  lng                Float?
  accuracyM          Float?
  clientRecordedAt   DateTime?
  permissionState    String?
  locationProvider   String?
  distanceToPlannedM Float?
  verification       VisitGpsVerification
  createdAt          DateTime             @default(now())

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, createdAt])
}

/// Профиль полевого менеджера: нормы для расчёта топлива.
model UserFieldProfile {
  userId              String    @id
  fuelLitersPer100km  Float     @default(8)
  fuelPricePerLiter   Decimal?  @db.Decimal(12, 2)
  vehicleLabel        String?
  usePersonalCar      Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Рабочая смена (политика GPS и группировка трековых точек).
model FieldShift {
  id                  String           @id @default(cuid())
  ownerId             String
  /// Календарный день (начало UTC 00:00 выбранного дня задаётся приложением/backend).
  date                DateTime
  status              FieldShiftStatus @default(ACTIVE)
  startedAt           DateTime         @default(now())
  endedAt             DateTime?
  trackingEnabled     Boolean          @default(true)
  plannedDistanceKm   Float?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  owner        User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  samples      FieldLocationSample[]
  fuelReports  FuelDayReport[]

  @@index([ownerId, date])
  @@index([ownerId, status])
}

model FieldLocationSample {
  id               String   @id @default(cuid())
  shiftId          String
  lat              Float
  lng              Float
  accuracyM        Float?
  clientRecordedAt DateTime
  createdAt        DateTime @default(now())

  shift FieldShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, clientRecordedAt])
}

/// Дневной отчёт по топливу/компенсации для менеджера.
model FuelDayReport {
  id                   String                  @id @default(cuid())
  ownerId              String
  date                 DateTime
  shiftId              String?
  plannedKm            Float?
  actualKm             Float?
  /// Км для расчёта компенсации (= actualKm при политике «факт»).
  compensationKm       Float?
  litersEstimated      Float?
  amountEstimated      Decimal?                @db.Decimal(14, 2)
  /// Источник расчёта фактического маршрута: google | fallback | none.
  metricsSource        String?
  visitCount           Int?
  calculationSnapshot  Json?
  compensationStatus   FuelCompensationStatus  @default(DRAFT)
  submittedAt          DateTime?
  managerNote          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  owner User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  shift FieldShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@unique([ownerId, date])
  @@index([shiftId])
  @@index([ownerId, date, compensationStatus])
}

model RoutePlan {
  id        String   @id @default(cuid())
  ownerId   String
  date      DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  stops         RouteStop[]
  routeSessions RouteSession[]

  @@unique([ownerId, date])
  @@index([date])
}

model RouteSession {
  id             String    @id @default(cuid())
  ownerId        String
  date           DateTime
  routePlanId    String?
  isActive       Boolean   @default(true)
  currentVisitId String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  routePlan    RoutePlan? @relation(fields: [routePlanId], references: [id], onDelete: SetNull)
  currentVisit Visit?     @relation(fields: [currentVisitId], references: [id], onDelete: SetNull)

  @@unique([ownerId, date])
  @@index([date])
}

model RouteStop {
  id          String @id @default(cuid())
  routePlanId String
  visitId     String
  position    Int

  routePlan RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  visit     Visit     @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@unique([routePlanId, position])
  @@unique([routePlanId, visitId])
  @@index([visitId])
}

model Lead {
  id               String       @id @default(cuid())
  companyId        String
  ownerId          String?
  contactId        String?
  status           LeadStatus   @default(NEW)
  source           LeadSource   @default(OTHER)
  channel          LeadChannel?
  name             String?
  firstName        String?
  lastName         String?
  middleName       String?
  fullName         String?
  phone            String?
  phoneNormalized  String?
  email            String?
  companyName      String?
  /// Область (довідник областей України).
  region           String?
  city             String?
  /// Ref населеного пункту Нової Пошти (довідник NP).
  npCityRef        String?
  /// Повна адреса (Google Places / вручну).
  address          String?
  lat              Float?
  lng              Float?
  googlePlaceId    String?
  message          String?
  comment          String?
  statusReason     String?
  sourceMeta       Json?
  score            Int          @default(0)
  lastActivityAt   DateTime?
  /**
   * Set when lead is converted to an order — enables exact conversion analytics
   */
  convertedOrderId String?      @unique
  legacySource     String?
  legacyId         Int?
  legacyRaw        Json?
  syncedAt         DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  convertedOrder       Order?                @relation(fields: [convertedOrderId], references: [id], onDelete: SetNull)
  contact              Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner                User?                 @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  company              Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                LeadItem[]
  attribution          LeadMetaAttribution?
  answers              LeadAnswer[]
  events               LeadEvent[]
  identities           LeadIdentity[]
  telegramAccounts     TelegramAccount[]
  conversations        Conversation[]
  tasks                Task[]
  activities           Activity[]
  outboundCallAttempts OutboundCallAttempt[]
  materialReservations MaterialReservation[]
  callQueueItems       CallQueueItem[]
  manualCallSessions   ManualCallSession[]

  @@unique([legacySource, legacyId])
  @@index([companyId, status])
  @@index([companyId, source])
  @@index([phone])
  @@index([phoneNormalized])
  @@index([email])
  @@index([contactId])
}

