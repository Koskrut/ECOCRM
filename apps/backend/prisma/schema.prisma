  COMPANY
  LEAD
  ORDER
  PRODUCT
  TASK
  ACTIVITY
}

enum CustomFieldType {
  TEXT
  NUMBER
  MONEY
  DATE
  BOOLEAN
  SELECT
  MULTISELECT
  USER
  DICTIONARY_ITEM
  JSON
}

enum LayoutType {
