/// Рабочая смена (политика GPS и группировка трековых точек).
model UserActivitySession {
  id            String         @id @default(cuid())
  userId        String
  platform      ClientPlatform
  ip            String?
  userAgent     String?
  ipCity        String?
  ipRegion      String?
  ipCountry     String?
  lat           Float?
  lng           Float?
  startedAt     DateTime       @default(now())
  lastSeenAt    DateTime       @default(now())
  activeSeconds Int            @default(0)
  appState      String?
