model OutboundCampaign {
  id              String             @id @default(cuid())
  name            String
  targetType      OutboundTargetType
  scenarioCode    String
  scenarioVersion String
  isActive        Boolean            @default(true)
  /**
   * maxCallsPerDay, dormantDaysMin, defaultAssigneeUserId, quietHours: { start, end }, timezone
   */
  config          Json?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  attempts OutboundCallAttempt[]

  @@index([isActive])
  @@index([targetType])
}

model OutboundCallAttempt {
  id                   String                @id @default(cuid())
  campaignId           String
  targetType           OutboundTargetType
  leadId               String?
  contactId            String?
  companyId            String?
  phoneNormalized      String
  scenarioCode         String
  scenarioVersion      String
  status               OutboundAttemptStatus @default(PENDING)
  provider             String?
  providerSessionId    String?               @unique
  /**
   * Gateway/external session id when different from providerSessionId
   */
  externalSessionId    String?
  callId               String?               @unique
  scheduledAt          DateTime?
  lastError            String?
  transcript           String?               @db.Text
  summary              String?               @db.Text
  outcome              Json?
  /**
   * Idempotent processing of final provider webhook delivery
   */
  webhookProcessedId   String?               @unique
  /**
   * e.g. HTTP_OUTBOUND_VOICE, KYIVSTAR_OPENAI_GATEWAY, STUB
   */
  runtimeProvider      String?
  providerCallId       String?
  openaiCallId         String?
  recordingExternalId  String?
  transcriptStatus     String?
  summaryStatus        String?
  classificationStatus String?
  transferStatus       String?
  catalogSentAt        DateTime?
  lastRuntimeEventAt   DateTime?
  lastRuntimeEventType String?
  failureCode          String?
  failureReason        String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  campaign             OutboundCampaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead                 Lead?                         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact              Contact?                      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  call                 Call?                         @relation(fields: [callId], references: [id], onDelete: SetNull)
  runtimeWebhookEvents OutboundRuntimeWebhookEvent[]

  @@index([campaignId, status])
  @@index([status, scheduledAt])
  @@index([leadId])
  @@index([contactId])
  @@index([externalSessionId])
}

/**
 * Idempotent log of gateway realtime webhook deliveries (AI outbound).
 */
model OutboundRuntimeWebhookEvent {
  id          String   @id @default(cuid())
  attemptId   String
  eventType   String
  /**
   * Globally unique delivery id for idempotency (optional for legacy bodies).
   */
  deliveryId  String?  @unique
  payloadJson Json
  source      String   @default("gateway")
  createdAt   DateTime @default(now())

  attempt OutboundCallAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId])
  @@index([eventType])
}

model CallQueueItem {
  id         String              @id @default(cuid())
  assigneeId String
  leadId     String?
  contactId  String?
  companyId  String?
  /**
   * Пропущений вхідний дзвінок, з якого створено елемент очереди (ідемпотентність re-ingest).
   */
  callId     String?             @unique
  status     CallQueueItemStatus @default(PENDING)
  sortOrder  Int                 @default(0)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  assignee User                @relation(fields: [assigneeId], references: [id], onDelete: Cascade)
  lead     Lead?               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact?            @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company  Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  call     Call?               @relation(fields: [callId], references: [id], onDelete: SetNull)
  sessions ManualCallSession[]

  @@index([assigneeId, status, sortOrder])
  @@index([assigneeId, status])
  @@index([assigneeId, contactId, status])
  @@index([assigneeId, leadId, status])
}

model ManualCallSession {
  id                       String                  @id @default(cuid())
  queueItemId              String
  userId                   String
  status                   ManualCallSessionStatus @default(OPEN)
  startedAt                DateTime                @default(now())
  completedAt              DateTime?
  outcome                  ManualCallOutcome?
  note                     String?                 @db.Text
  callbackAt               DateTime?
  /**
   * Нормалізований номер клієнта на момент сесії — для best-effort Ringostat match.
   */
  targetPhoneNormalized    String?
  callId                   String?
  activityId               String?                 @unique
  completionIdempotencyKey String?                 @unique
  leadId                   String?
  contactId                String?
  companyId                String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt

  queueItem CallQueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  call      Call?         @relation(fields: [callId], references: [id], onDelete: SetNull)
  activity  Activity?     @relation(fields: [activityId], references: [id], onDelete: SetNull)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([queueItemId])
  @@index([userId, status])
  @@index([callId])
}

model IntegrationSetting {
  id            String    @id @default(cuid())
  provider      String
  companyId     String?
  isEnabled     Boolean   @default(false)
  webhookSecret String?
  apiToken      String?
  config        Json?
  lastWebhookAt DateTime?
  lastPollAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([provider, companyId])
  @@index([provider])
}

model IntegrationSyncState {
  id          String    @id @default(cuid())
  integration String
  entity      String
  lastSyncAt  DateTime?
  lastCursor  String?
  lastRunAt   DateTime?
  status      String?
  error       String?

  @@unique([integration, entity])
}

model IntegrationWebhookEvent {
  id             String    @id @default(cuid())
  integration    String
  eventType      String
  entityType     String?
  entityLegacyId Int?
  payload        Json
  payloadHash    String?
  status         String?
  error          String?
  receivedAt     DateTime  @default(now())
  processedAt    DateTime?

  @@index([integration])
  @@index([eventType])
  @@index([entityType])
  @@index([entityLegacyId])
  @@index([status])
  @@index([receivedAt])
}

enum HelpAudience {
  PRODUCT
  BUSINESS
}

enum HelpArticleStatus {
  DRAFT
  PUBLISHED
}

model HelpCategory {
  id        String       @id @default(cuid())
  key       String       @unique
  title     String
  audience  HelpAudience
  sortOrder Int          @default(0)
  icon      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  articles HelpArticle[]

  @@index([audience, sortOrder])
}

model HelpArticle {
  id           String            @id @default(cuid())
  slug         String            @unique
  seedKey      String?           @unique
  categoryId   String
  audience     HelpAudience
  status       HelpArticleStatus @default(DRAFT)
  locale       String            @default("uk")
  title        String
  excerpt      String?
  bodyMd       String            @db.Text
  sortOrder    Int               @default(0)
  visibleRoles Json?
  seedRevision Int?
  createdById  String?
  updatedById  String?
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  category HelpCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  bindings HelpArticleBinding[]

  @@index([audience, status])
  @@index([categoryId, sortOrder])
}

model HelpArticleBinding {
  id         String  @id @default(cuid())
  articleId  String
  routeKey   String?
  entityType String?
  sortOrder  Int     @default(0)

  article HelpArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([routeKey])
  @@index([entityType])
  @@index([articleId, sortOrder])
}

// --- Risk Management (ext.risk_management) ---

enum RiskDomainId {
  CLIENT_CREDIT
  CLIENT_HEALTH
  CASH_OPS
  FX
  INV
  MFG
  SHIP
  FIELD
  TEAM
  QA
  LEAD
  SYS
}

enum RiskSubjectType {
  CONTACT
  COMPANY
  ORDER
  LEAD
  PRODUCT
  WAREHOUSE
  PRODUCTION_BATCH
  PACKING_LIST
  FACTORY_ORDER
  VISIT
  USER
  SYSTEM
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskSeverity {
  INFO
  WARNING
  HIGH
  CRITICAL
}

enum RiskDecisionOutcome {
  ALLOW
  WARN
  REQUIRE_APPROVAL
  BLOCK
}

enum CreditProfileStatus {
  ACTIVE
  WATCH
  HOLD
  BLOCKED
}

enum RiskClass {
  A
  B
  C
  D
  BLOCK
}

enum RiskPlaybookRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

model CreditProfile {
  id                 String              @id @default(cuid())
  contactId          String?             @unique
  companyId          String?             @unique
  creditLimit        Decimal             @default(0) @db.Decimal(18, 2)
  currency           String              @default("UAH")
  utilizedExposure   Decimal             @default(0) @db.Decimal(18, 2)
  availableCredit    Decimal             @default(0) @db.Decimal(18, 2)
  riskClass          RiskClass           @default(B)
  paymentTermsDays   Int                 @default(14)
  status             CreditProfileStatus @default(ACTIVE)
  notes              String?             @db.Text
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([riskClass])
}

model RiskSignalEvent {
  id          String           @id @default(cuid())
  domain      RiskDomainId
  signalCode  String
  severity    RiskSeverity
  subjectType RiskSubjectType
  subjectId   String
  payload     Json?
  occurredAt  DateTime         @default(now())
  createdAt   DateTime         @default(now())

  @@index([domain, occurredAt])
  @@index([subjectType, subjectId])
  @@index([signalCode, occurredAt])
}

model RiskScoreSnapshot {
  id           String          @id @default(cuid())
  domain       RiskDomainId
  subjectType  RiskSubjectType
  subjectId    String
  score        Int
  band         RiskBand
  reasons      Json
  modelVersion String          @default("scorecard-v1")
  computedAt   DateTime        @default(now())

  @@unique([domain, subjectType, subjectId])
  @@index([domain, band])
  @@index([computedAt])
}

model EnterpriseRiskSnapshot {
  id          String   @id @default(cuid())
  eriScore    Int
  eriBand     RiskBand
  breakdown   Json
  modelVersion String  @default("eri-v1")
  computedAt  DateTime @default(now())

  @@index([computedAt])
}

model RiskPolicy {
  id        String       @id @default(cuid())
  domain    RiskDomainId @unique
  rules     Json
  weight    Float        @default(1)
  enabled   Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model RiskDecision {
  id             String              @id @default(cuid())
  domain         RiskDomainId
  gatePoint      String
  outcome        RiskDecisionOutcome
  subjectType    RiskSubjectType
  subjectId      String
  orderId        String?
  reasons        Json
  scoreSnapshot  Json?
  requestedById  String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime            @default(now())

  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([outcome, createdAt])
  @@index([orderId])
  @@index([subjectType, subjectId])
}

model RiskPlaybook {
  id            String       @id @default(cuid())
  key           String       @unique
  domain        RiskDomainId
  triggerBand   RiskBand
  actions       Json
  enabled       Boolean      @default(true)
  cooldownHours Int          @default(24)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  runs RiskPlaybookRun[]
}

model RiskPlaybookRun {
  id          String                @id @default(cuid())
  playbookId  String
  domain      RiskDomainId
  subjectType RiskSubjectType
  subjectId   String
  status      RiskPlaybookRunStatus @default(PENDING)
  result      Json?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime              @default(now())

  playbook RiskPlaybook @relation(fields: [playbookId], references: [id], onDelete: Cascade)

  @@index([playbookId, createdAt])
  @@index([subjectType, subjectId])
}
