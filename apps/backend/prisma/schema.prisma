  routeSessionsAsCurrent RouteSession[]
  visitGpsEvents         VisitGpsEvent[]
  dailyWorkPlanItems     DailyWorkPlanItem[]

  @@index([ownerId, status])
  @@index([ownerId, startsAt])
  @@index([companyId])
  @@index([contactId])
  @@index([contactAddressId])
  @@index([companyAddressId])
}

