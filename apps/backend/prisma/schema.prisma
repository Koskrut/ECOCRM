  nextValue Int
}

/// Configurable order stage pipeline (labels, order, transitions). Enum `OrderStage` remains system codes.
model OrderPipelineStage {
  stage        OrderStage       @id
  sortOrder    Int
  label        String
  color        String?
  kanbanGroup  OrderKanbanGroup
  allowedNext  Json

  @@map("OrderPipelineStage")
}

model Order {
  id          String  @id @default(cuid())
  orderNumber String  @unique
  companyId   String?

  // старое поле (если используешь как "клиент заказа")
  clientId String?

  // поле — контакт для ТТН
  contactId String?

  ownerId            String
  /**
   * @deprecated Phase 7: use orderStage. Kept for backward compat; no longer written.
   */
  status             OrderStatus?
  currency           String
  subtotalAmount     Float
  discountAmount     Float
  totalAmount        Float
  paidAmount         Float
  debtAmount         Float
  comment            String?
  legacySource       String?
  legacyId           Int?
  legacyRaw          Json?
  syncedAt           DateTime?
  /// Last NP status sync (cron bulk or manual); drives fair selection order for bulk sync.
  lastNpStatusSyncAt DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  deliveryMethod     DeliveryMethod?
  paymentMethod      PaymentMethod?
  /**
   * Банковский счёт (ФОП) при оплате FOP.
   */
  bankAccountId      String?
  /**
   * Склад отгрузки.
   */
  warehouseId        String?
  /**
   * Bitrix UF_CRM_1753788124915 — Документы (Да/нет).
   */
  documentsRequested Boolean?
  paymentType        PaymentType?
  deliveryData       Json?
  orderSource        OrderSource     @default(CRM)
  /**
   * Номер и дата счёта (из 1С).
   */
  invoiceNumber      String?
  invoiceDate        DateTime?
  /**
   * Номер и дата РН / расходной накладной (из 1С).
   */
  waybillNumber      String?
  waybillDate        DateTime?
  /**
   * Курс сделки для таблицы/документов.
   */
  exchangeRate       Float?

  // --- New order model (Phase 1): keep status for compatibility ---
  orderStage             OrderStage?
  deliveryStatus         DeliveryStatus?
  financialStatus        OrderFinancialStatus?
  paymentDueDate         DateTime?
  /// Phase 5: sum of amounts from closed returns (reduces effective total for debt calc).
  returnAdjustmentAmount Float                 @default(0)

  /// Backorder / stock split: child order points to the order it was split from.
  parentOrderId String?
  parentOrder   Order?  @relation("OrderSplit", fields: [parentOrderId], references: [id], onDelete: SetNull)
  childOrders   Order[] @relation("OrderSplit")

  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  warehouse   Warehouse?   @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  // Order.clientId -> Contact
  client Contact? @relation("OrderClient", fields: [clientId], references: [id], onDelete: SetNull)

  // Order.contactId -> Contact (для ТТН)
  contact Contact? @relation("OrderContact", fields: [contactId], references: [id], onDelete: SetNull)

  items             OrderItem[]
  statusHistory     OrderStatusHistory[]
  activities        Activity[]
  tasks             Task[]
  convertedFromLead Lead?

  ttns              OrderTtn[]
  shipments         Shipment[]
  payments          Payment[]
  paymentRequests   PaymentRequest[]
  returns           OrderReturn[]
  productionBatches ProductionBatch[]
  reservations      MaterialReservation[]
  weeklyPlanItems   WeeklyPlanItem[]

  @@unique([legacySource, legacyId])
  @@index([companyId])
  @@index([clientId])
  @@index([contactId])
  @@index([ownerId])
  @@index([bankAccountId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderSource])
  @@index([orderStage])
  @@index([financialStatus])
  @@index([lastNpStatusSyncAt])
  @@index([parentOrderId])
}

model OrderItem {
  id                  String  @id @default(cuid())
  orderId             String
  productId           String?
  productNameSnapshot String? // название из Bitrix при отсутствии Product в ECOCRM
  qty                 Int
  price               Float
  lineTotal           Float

  // кеш для частичных отправок
  qtyShipped Int @default(0)

  legacySource String?
  legacyId     Int?
  legacyRaw    Json?
  syncedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id])

  // связи с конкретными ТТН (частичная отгрузка)
  ttnItems      OrderTtnItem[]
  shipmentItems ShipmentItem[]
  returnItems   OrderReturnItem[]

  @@unique([orderId, productId], name: "orderId_productId")
  @@unique([legacySource, legacyId])
  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id             String       @id @default(cuid())
  orderId        String
  fromStatus     OrderStatus?
  toStatus       OrderStatus
  /**
   * Phase 7: primary axis for timeline; set when recording stage change.
   */
  fromOrderStage OrderStage?
  toOrderStage   OrderStage?
  changedBy      String
  reason         String?
  createdAt      DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([toStatus])
  @@index([toOrderStage])
  @@index([createdAt])
}

model OrderTtn {
  id         String  @id @default(cuid())
  /// @deprecated use shipmentId as the source of truth
  orderId    String?
  shipmentId String?
  carrier    Carrier @default(NOVA_POSHTA)

  documentNumber String
  documentRef    String?

  statusCode String?
  statusText String?

  cost                  Float?
  estimatedDeliveryDate DateTime?

  payloadSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    Order?    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  // ✅ позиции, которые уехали в этой ТТН
  items OrderTtnItem[]

  @@index([orderId])
  @@index([shipmentId])
  @@index([documentNumber])
  @@index([statusCode])
  @@index([updatedAt])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  contactId         String?
  carrier           Carrier        @default(NOVA_POSHTA)
  status            ShipmentStatus @default(DRAFT)
  recipientSnapshot Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contact Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  items   ShipmentItem[]
  ttns    OrderTtn[]

  @@index([orderId])
  @@index([contactId])
  @@index([status])
  @@index([carrier])
}

model ShipmentItem {
