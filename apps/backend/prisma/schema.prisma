  updatedAt DateTime @updatedAt
}

model Dictionary {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  system      Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  items DictionaryItem[]
  customFields CustomFieldDefinition[]

  @@index([system])
  @@index([isActive])
  @@index([deletedAt])
}

model DictionaryItem {
  id           String    @id @default(cuid())
  dictionaryId String
  key          String
  label        String
  value        String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  dictionary Dictionary @relation(fields: [dictionaryId], references: [id], onDelete: Cascade)
  customFieldValues CustomFieldValue[]

  @@unique([dictionaryId, key])
  @@index([dictionaryId, sortOrder])
  @@index([dictionaryId, isActive])
  @@index([deletedAt])
}

model CustomFieldDefinition {
  id           String                @id @default(cuid())
  entityType   CustomFieldEntityType
  key          String
  label        String
  description  String?
  type         CustomFieldType
  required     Boolean               @default(false)
  isActive     Boolean               @default(true)
  system       Boolean               @default(false)
  dictionaryId String?
  settings     Json?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  deletedAt    DateTime?

  dictionary Dictionary?          @relation(fields: [dictionaryId], references: [id], onDelete: SetNull)
  options    CustomFieldOption[]
  values     CustomFieldValue[]
  layoutFields LayoutField[]

  @@unique([entityType, key])
  @@index([entityType, isActive])
  @@index([dictionaryId])
  @@index([deletedAt])
}

model CustomFieldOption {
  id           String    @id @default(cuid())
  definitionId String
  key          String
  label        String
  value        String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  metadata     Json?
