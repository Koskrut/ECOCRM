// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum OrderStatus {
  NEW // создан, не утвержден
  IN_WORK // утвержден + есть ТТН (или начат в работе)
  READY_TO_SHIP // собран, готов к отправке
  SHIPPED // в пути / принято / едет
  CONTROL_PAYMENT // получено, но есть долг
  SUCCESS // получено и долг=0
  RETURNING // возврат / отказ / не вручено
  CANCELED // отмена
}

enum DeliveryMethod {
  PICKUP
  NOVA_POSHTA
}

enum PaymentMethod {
  FOP
  CASH
}

enum PaymentType {
  PREPAYMENT // предоплата
  DEFERRED // отсрочка
}

enum UserRole {
  USER
  WAREHOUSE
  LEAD
  MANAGER
  ADMIN
}

enum NpRecipientType {
  PERSON
  COMPANY
}

enum NpDeliveryType {
  WAREHOUSE
  POSTOMAT
  ADDRESS
}

enum Carrier {
  NOVA_POSHTA
}

enum ShipmentStatus {
  DRAFT
  READY
  IN_TRANSIT
  DELIVERED
  CANCELED
}

enum ActivityType {
  COMMENT
  CALL
  MEETING
  /**
   * Ручний прозвон з Call Workspace (факт — у ManualCallSession).
   */
