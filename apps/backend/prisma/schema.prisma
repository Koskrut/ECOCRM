  companyId   String?
  leadId      String?
  orderId     String?
  title       String
  body        String?
  dueAt       DateTime?
  status      TaskStatus @default(OPEN)
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

