// --- MODELS ---

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  /** Lowercase login handle; unique. Used when signing in without full email. */
  username       String?   @unique
  fullName       String
  passwordHash   String
  role           UserRole  @default(MANAGER)
  isActive       Boolean   @default(true)
  telegramUserId String?   @unique
  telegramChatId String?   @unique
  legacySource   String?
  legacyId       Int?
  legacyRaw      Json?
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /**
   * Руководитель (для LEAD-иерархии и фильтрации визитов).
   */
  leadId      String?
  lead        User?   @relation("UserHierarchy", fields: [leadId], references: [id], onDelete: SetNull)
  teamMembers User[]  @relation("UserHierarchy")

  tasksCreated Task[] @relation("TaskCreatedBy")

  /**
   * Начало/конец дневного маршрута визитов (якоря для Google Maps).
   */
  routeStartLat   Float?
  routeStartLng   Float?
  routeEndLat     Float?
  routeEndLng     Float?
  routeStartLabel String?
  routeEndLabel   String?

  contacts                   Contact[]
  leads                      Lead[]
  orders                     Order[]
  payments                   Payment[]
  paymentRequestsCreated     PaymentRequest[]    @relation("PaymentRequestCreatedBy")
  clientBalanceTransactions  ClientBalanceTransaction[] @relation("ClientBalanceTransactionCreatedBy")
  settledOrderReturns        OrderReturn[]       @relation("OrderReturnSettledBy")
  fxWriteOffOrders           Order[]             @relation("OrderFxWriteOffBy")
  visits                     Visit[]
  routePlans                 RoutePlan[]
  routeSessions              RouteSession[]
  assignedConversations      Conversation[]
  outboundMessages           Message[]
  tasks                      Task[]
  companies                  Company[]
  importedInventorySnapshots InventorySnapshot[] @relation("InventorySnapshotImportedBy")
  postedInventorySnapshots   InventorySnapshot[] @relation("InventorySnapshotPostedBy")
  importedSalesHistoryUploads SalesHistoryUpload[] @relation("SalesHistoryUploadImportedBy")
  postedSalesHistoryUploads   SalesHistoryUpload[] @relation("SalesHistoryUploadPostedBy")
  importedReceivablesSnapshots ReceivablesSnapshot[] @relation("ReceivablesSnapshotImportedBy")
  callQueueItems             CallQueueItem[]
  manualCallSessions         ManualCallSession[]
  rbacAssignments            RbacUserRoleAssignment[]
  dataImportJobsCreated      DataImportJob[]           @relation("DataImportJobCreatedBy")
  fieldProfile               UserFieldProfile?
  fieldShifts                FieldShift[]
  fieldLocationSamples       FieldLocationSample[]
  fieldTrackingEvents        FieldTrackingEvent[]
  fuelDayReports             FuelDayReport[]
  fuelRefuelEntries          FuelRefuelEntry[]
  dayPlanOverride            UserDayPlanOverride?
  dayPlanOverridesUpdated    UserDayPlanOverride[] @relation("UserDayPlanOverrideUpdatedBy")
  dailyWorkPlans             DailyWorkPlan[]
  activitySessions           UserActivitySession[]

  /**
   * LEAD: копія складських/замовлень сповіщень по команді (фаза 2).
   */
  teamNotificationsEnabled   Boolean @default(false)
  notifications              UserNotification[]
  notificationPreferences    UserNotificationPreference[]
  pushDevices                UserPushDevice[]
  paymentMatchAudits         PaymentMatchAudit[] @relation("PaymentMatchAuditCreatedBy")
  bankTransactionsIgnored    BankTransaction[]   @relation("BankTransactionIgnoredBy")

  @@unique([legacySource, legacyId])
  @@index([leadId])
}

model RbacRole {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  system      Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  permissions RbacRolePermission[]
  assignments RbacUserRoleAssignment[]

  @@index([system])
  @@index([isActive])
  @@index([deletedAt])
}

model RbacPermission {
  id          String    @id @default(cuid())
  key         String    @unique
  name        String
  description String?
  category    String?
  system      Boolean   @default(false)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RbacRolePermission[]

  @@index([category])
  @@index([system])
  @@index([isActive])
  @@index([deletedAt])
}

model RbacRolePermission {
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       RbacRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission RbacPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RbacUserRoleAssignment {
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role RbacRole @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model PasswordResetCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([expiresAt])
}

model UserTelegramLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Company {
  id            String    @id @default(cuid())
  name          String
  edrpou        String?
  taxId         String?
  phone         String?
  address       String?
  /** Область (як у контактів). */
  region        String?
  lat           Float?
  lng           Float?
  googlePlaceId String?
  legacySource  String?
  legacyId      Int?
  legacyRaw     Json?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ownerId       String?

  owner              User?                  @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  contacts           Contact[]
  orders             Order[]
  activities         Activity[]
  leads              Lead[]
  payments           Payment[]
  visits             Visit[]
  clientBalances     ClientBalance[] @relation("CompanyClientBalance")
  balanceTransactions ClientBalanceTransaction[] @relation("CompanyBalanceTransactions")
  tasks              Task[]
  changeHistory      CompanyChangeHistory[]
  callQueueItems     CallQueueItem[]
  manualCallSessions ManualCallSession[]
  addresses          CompanyAddress[]
  creditProfile      CreditProfile?
  payerAliases       PayerAlias[]

  @@unique([legacySource, legacyId])
  @@index([ownerId])
  @@index([edrpou])
  @@index([taxId])
}

model CompanyAddress {
  id            String    @id @default(cuid())
  companyId     String
  label         String?
  city          String?
  addressText   String
  lat           Float?
  lng           Float?
  googlePlaceId String?
  isDefault     Boolean   @default(false)
  legacySource  String?
  legacyId      Int?
  legacyRaw     Json?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visits  Visit[]

  @@unique([legacySource, legacyId])
  @@index([companyId])
  @@index([companyId, isDefault])
}

model CompanyChangeHistory {
  id        String   @id @default(cuid())
  companyId String
  changedBy String?
  action    String // CREATED | UPDATED
  payload   Json? // e.g. [{ "field": "name", "oldValue": "x", "newValue": "y" }]
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([createdAt])
}

model Contact {
  id                  String    @id @default(cuid())
  ownerId             String?
  companyId           String?
  firstName           String
  lastName            String
  middleName          String?
  phone               String
  phoneNormalized     String? // цифры телефона для проверки уникальности по всей базе
  email               String?
  position            String?
  address             String?
  lat                 Float?
  lng                 Float?
  googlePlaceId       String?
  isPrimary           Boolean   @default(false)
  /**
   * Код 1С (импорт из Bitrix UF_CRM_1772007718612).
   */
  externalCode        String?
  /**
   * Как выводить на документ (счёт/РН): напр. «ФОП Петров Петр» при контакте Иванов Иван.
   */
  documentDisplayName String?
  /**
   * Область (Bitrix UF_CRM_1753079162490; fallback UF_CRM_1753079192866).
   */
  region              String?
  /**
   * Адрес (инфо) — строка из Bitrix ADDRESS.
   */
  addressInfo         String?
  /**
   * Город (Bitrix UF_CRM_1753079682882).
   */
  city                String?
  /**
   * Тип клиента: врач/техник (Bitrix UF_CRM_1756361960817).
   */
  clientType          String?
  /**
   * Статус клієнта (Bitrix UF_CRM_1755068668186).
   */
  status              String?
  /**
   * Відмова від маркетингових/AI дзвінків (outbound compliance).
   */
  marketingCallOptOut Boolean   @default(false)
  nextActionType      String?
  nextActionAt        DateTime?
  nextActionNote      String?
  clientStage         String?
  legacySource        String?
  legacyId            Int?
  legacyRaw           Json?
  syncedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  owner   User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  // связь для Order.clientId (старое поле clientId в Order)
  ordersAsClient Order[] @relation("OrderClient")

  // связь для Order.contactId (поле для ТТН)
  ordersAsContact Order[] @relation("OrderContact")

  // профили доставки НП (несколько на контакт)
  shippingProfiles ContactShippingProfile[]
  phones           ContactPhone[]
  addresses        ContactAddress[]

  activities           Activity[]
  leads                Lead[]
  payments             Payment[]
  visits               Visit[]
  clientBalances       ClientBalance[] @relation("ContactClientBalance")
  balanceTransactions  ClientBalanceTransaction[] @relation("ContactBalanceTransactions")
  telegramAccounts     TelegramAccount[]
  metaParticipants     MetaParticipant[]
  conversations        Conversation[]
  tasks                Task[]
  customer             Customer?
  outboundCallAttempts OutboundCallAttempt[]
  shipments            Shipment[]
  dailyWorkPlanItems   DailyWorkPlanItem[]
  changeHistory        ContactChangeHistory[]
  callQueueItems       CallQueueItem[]
  manualCallSessions   ManualCallSession[]
  receivablesSnapshotLines ReceivablesSnapshotLine[]
  creditProfile        CreditProfile?
  payerAliases         PayerAlias[]
  returnPackages       ReturnPackage[]

  @@unique([phoneNormalized])
  @@unique([legacySource, legacyId])
  @@index([companyId])
  @@index([ownerId])
}

model ContactChangeHistory {
  id        String   @id @default(cuid())
  contactId String
  changedBy String?
  action    String
  payload   Json?
  createdAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([createdAt])
}

model ContactAddress {
  id            String    @id @default(cuid())
  contactId     String
  label         String?
  city          String?
  addressText   String
  lat           Float?
  lng           Float?
  googlePlaceId String?
  isDefault     Boolean   @default(false)
  legacySource  String?
  legacyId      Int?
  legacyRaw     Json?
  syncedAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  visits  Visit[]

  @@unique([legacySource, legacyId])
  @@index([contactId])
  @@index([contactId, isDefault])
}

model Customer {
  id           String   @id @default(cuid())
  contactId    String   @unique
  email        String?
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contact                 Contact                  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  carts                   Cart[]
  storePasswordResetCodes StorePasswordResetCode[]

  @@index([contactId])
}

model StorePasswordResetCode {
  id         String   @id @default(cuid())
  customerId String
  code       String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

model Visit {
  id             String         @id @default(cuid())
  companyId      String?
  contactId      String?
  ownerId        String
  title          String?
  phone          String?
  addressText    String?
  lat            Float?
  lng            Float?
  locationSource LocationSource @default(NONE)
  radiusM        Int            @default(100)
  status         VisitStatus    @default(PLANNED_UNASSIGNED)
  startsAt       DateTime?
  endsAt         DateTime?
  durationMin    Int            @default(60)
  note           String?
  /**
   * Цель встречи (при постановке в план).
   */
  purpose        String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  startedAt      DateTime?
  completedAt    DateTime?
  outcome        VisitOutcome?
  resultNote     String?
  nextActionAt   DateTime?
  nextActionNote String?
  activityId     String?       @unique // timeline activity: "план" → updated to result when completed

  /** Итог GPS-проверки при последнем START визита. */
  startGpsVerification VisitGpsVerification?
  /** Итог GPS-проверки при последнем COMPLETE визита. */
  completeGpsVerification VisitGpsVerification?

  contactAddressId String?
  companyAddressId String?

  company                Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contact                Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactAddress         ContactAddress? @relation(fields: [contactAddressId], references: [id], onDelete: SetNull)
  companyAddress         CompanyAddress? @relation(fields: [companyAddressId], references: [id], onDelete: SetNull)
  owner                  User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  activity               Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
