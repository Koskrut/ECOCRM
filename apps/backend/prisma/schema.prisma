// ===== Payment module =====

model BankAccount {
  id                  String       @id @default(cuid())
  provider            BankProvider @default(PRIVAT24)
  name                String
  currency            String
  accountNumber       String?
  iban                String?
  /**
   * Код ФОП для 1С/таблицы (напр. 000000123).
   */
  externalCode        String?      @unique
  /**
   * Код счета ФОП для 1С/таблицы (напр. 000000456).
   */
  accountExternalCode String?      @unique
  /**
   * Реквизиты для счёта/РН: legalName, taxId, address, bankDetails и т.д.
   */
  documentRequisites  Json?
  credentials         Json? // encrypted: cardNumber, clientId, token
  isActive            Boolean      @default(true)
  lastSyncAt          DateTime?
  lastBookedAt        DateTime? // max bookedAt of imported tx for incremental window
  syncCursor          String?
  syncWindowDays      Int          @default(2) // days overlap for from = lastBookedAt - N
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  transactions BankTransaction[]
  orders       Order[]
  upcConsent   UpcConsent?

  @@index([provider, isActive])
}

model UpcConsent {
  id            String    @id @default(cuid())
  bankAccountId String    @unique
  consentId     String
  status        String
  expiresAt     DateTime?
  lastRefreshAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@index([consentId])
  @@index([status])
}

model BankTransaction {
  id               String               @id @default(cuid())
  bankAccountId    String
  externalId       String? // API id when stable; else use dedupKey from hash
  dedupKey         String // externalId ?? hash for upsert uniqueness
  hash             String? // hash(bookedAt+amount+desc+...) when no externalId
  bookedAt         DateTime
  amount           Decimal              @db.Decimal(18, 2)
  currency         String
  direction        TransactionDirection
  description      String?
  counterpartyName String?
  counterpartyIban String?
  rawPayload       Json?
  importedAt       DateTime             @default(now())
  createdAt        DateTime             @default(now())

  matchStatus        BankTransactionMatchStatus @default(UNMATCHED)
  matchScore         Int?
  suggestedOrderId   String?

  /// Why the tx was marked TECHNICAL/IGNORED (fees, tax, own transfer, …).
  ignoreCategory   BankIgnoreCategory?
  ignoreSource     BankIgnoreSource?
  ignoredAt        DateTime?
  ignoredByUserId  String?

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  payments    Payment[]
  matchAudits PaymentMatchAudit[]
  ignoredBy   User?     @relation("BankTransactionIgnoredBy", fields: [ignoredByUserId], references: [id], onDelete: SetNull)

  @@unique([bankAccountId, dedupKey])
  @@index([matchStatus])
  @@index([bankAccountId, bookedAt])
  @@index([bankAccountId])
  @@index([bookedAt])
  @@index([counterpartyIban])
  @@index([ignoreCategory])
}

/// Learned / manual mapping from payer IBAN or normalized name → contact/company.
model PayerAlias {
  id                       String           @id @default(cuid())
  contactId                String?
  companyId                String?
  counterpartyIban         String?
  counterpartyNameNormalized String?
  source                   PayerAliasSource @default(LEARNED)
  hitCount                 Int              @default(1)
  lastSeenAt               DateTime         @default(now())
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt

  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([counterpartyIban])
  @@index([counterpartyNameNormalized])
  @@index([contactId])
  @@index([companyId])
  @@unique([counterpartyIban])
}

/// Audit trail for bank payment match decisions (auto / suggested confirm / manual).
model PaymentMatchAudit {
  id                String               @id @default(cuid())
  bankTransactionId String
  paymentIds        String[]
  decision          PaymentMatchDecision
  reasons           Json?
  score             Int?
  matchReason       String?
  createdAt         DateTime             @default(now())
  createdByUserId   String?

  bankTransaction BankTransaction @relation(fields: [bankTransactionId], references: [id], onDelete: Cascade)
  createdBy       User?           @relation("PaymentMatchAuditCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([bankTransactionId])
  @@index([createdAt])
}

/// Stores completed (or in-flight) finance POST responses keyed by Idempotency-Key header.
model FinanceIdempotencyRecord {
  id               String   @id @default(cuid())
  idempotencyKey   String   @unique
  httpMethod       String
  path             String
  bodySha256       String
  /// 0 = handler not finished yet; otherwise HTTP status of cached response body.
  responseStatus   Int
  responseBody     Json?
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

/// Client prepayment balance (credit from returns, applied to future orders).
model ClientBalance {
  id         String            @id @default(cuid())
  holderKind BalanceHolderKind
  holderId   String
  currency   String
  amount     Decimal           @default(0) @db.Decimal(18, 2)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  contactId String?
  companyId String?

  contact      Contact?                   @relation("ContactClientBalance", fields: [contactId], references: [id], onDelete: Cascade)
  company      Company?                   @relation("CompanyClientBalance", fields: [companyId], references: [id], onDelete: Cascade)
  transactions ClientBalanceTransaction[]

  @@unique([holderKind, holderId, currency])
  @@index([contactId])
  @@index([companyId])
}

model ClientBalanceTransaction {
  id              String                       @id @default(cuid())
  balanceId       String
  type            ClientBalanceTransactionType
  /// Signed delta: positive increases balance, negative decreases.
  amount          Decimal                      @db.Decimal(18, 2)
  currency        String
  contactId       String?
  companyId       String?
  orderId         String?
  orderReturnId   String?
  paymentId       String?                      @unique
  note            String?
  createdByUserId String?
  createdAt       DateTime                     @default(now())

  balance     ClientBalance @relation(fields: [balanceId], references: [id], onDelete: Cascade)
  contact     Contact?      @relation("ContactBalanceTransactions", fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?      @relation("CompanyBalanceTransactions", fields: [companyId], references: [id], onDelete: SetNull)
  order       Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderReturn OrderReturn?  @relation(fields: [orderReturnId], references: [id], onDelete: SetNull)
  payment     Payment?      @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("ClientBalanceTransactionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([balanceId])
  @@index([orderId])
  @@index([orderReturnId])
  @@index([contactId])
  @@index([companyId])
  @@index([createdAt])
}

model Payment {
  id                String            @id @default(cuid())
  orderId           String
  contactId         String?
  companyId         String?
  sourceType        PaymentSourceType
  amount            Decimal           @db.Decimal(18, 2)
  currency          String
  /**
   * Fixed USD equivalent at payment date; only admin can change.
   */
  amountUsd         Decimal?          @db.Decimal(18, 2)
  paidAt            DateTime
  status            PaymentStatus     @default(COMPLETED)
  bankTransactionId String?
  createdByUserId   String?
  note              String?
  /// Pairs CREDIT_TRANSFER out/in payments for audit.
  transferGroupId   String?
  /// Counterpart order for CREDIT_TRANSFER (source or target).
  linkedOrderId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  order                    Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contact                  Contact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company                  Company?         @relation(fields: [companyId], references: [id], onDelete: SetNull)
  bankTransaction          BankTransaction? @relation(fields: [bankTransactionId], references: [id], onDelete: SetNull)
  createdBy                User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  linkedFromPaymentRequest PaymentRequest?
  balanceTransaction       ClientBalanceTransaction?

  @@index([orderId])
  @@index([bankTransactionId])
  @@index([paidAt])
  @@index([transferGroupId])
  @@index([linkedOrderId])
}

/// Посилання на оплату за IBAN (snapshot реквізитів); публічний доступ лише за publicToken.
model PaymentRequest {
  id      String               @id @default(cuid())
  orderId String
  status  PaymentRequestStatus @default(PENDING)

  amount    Decimal  @db.Decimal(18, 2)
  currency  String
  purpose   String
  expiresAt DateTime

  recipientName String
  iban          String
  edrpou        String?
  mfo           String?
  bankName      String?

  publicToken String @unique
  /**
   * Офіційний deeplink НБУ (https://bank.gov.ua/qr/...) — той самий payload, що й для QR.
   */
  nbuDeeplink String @db.Text

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  paidAt          DateTime?
  linkedPaymentId String?   @unique

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdBy     User?    @relation("PaymentRequestCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  linkedPayment Payment? @relation(fields: [linkedPaymentId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([expiresAt])
  @@index([publicToken])
}

