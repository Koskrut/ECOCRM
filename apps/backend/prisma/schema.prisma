  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@unique([orderReturnId, orderItemId])
  @@index([orderReturnId])
  @@index([orderItemId])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  title      String?
  body       String
  occurredAt DateTime?
  pinnedAt   DateTime?
  createdBy  String
  createdAt  DateTime     @default(now())

  orderId   String?
  contactId String?
  companyId String?
  leadId    String?
  callId    String? @unique

  legacySource String?
  legacyId     Int?

  order             Order?             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  contact           Contact?           @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company           Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lead              Lead?              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  visit             Visit? // back-relation: visit that uses this timeline activity (one-to-one)
  call              Call?              @relation("ActivityCall", fields: [callId], references: [id], onDelete: SetNull)
  manualCallSession ManualCallSession?

  @@unique([legacySource, legacyId])
  @@index([orderId])
  @@index([contactId])
  @@index([companyId])
  @@index([leadId])
  @@index([createdAt])
  @@index([callId])
}

model AuditLog {
