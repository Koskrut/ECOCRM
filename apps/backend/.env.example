DATABASE_URL="xxxxx"
JWT_SECRET="xxxx"

# Set CRON_ENABLED=true on the server so scheduled jobs (Bank sync, NP TTN, Ringostat, Bitrix, Outbound AI dialer) run. Leave unset locally to avoid P1017 connection errors with Docker Postgres.
# CRON_ENABLED=true

# Outbound AI voice: POST /integrations/outbound-voice/webhook header x-outbound-voice-secret (or IntegrationSetting OUTBOUND_VOICE in CRM).
# Webhook body may include externalCallId (+ optional callProvider, default RINGOSTAT) to link the attempt to an existing Call row.
# Post-call transcript analysis uses the same OpenAI key as Telegram Inbox AI (Settings → Telegram or OPENAI_API_KEY below).
# OUTBOUND_VOICE_WEBHOOK_SECRET=
# Dev: after stub dial, auto-complete attempt (uses processCompletionInternal; no HTTP secret check for that path).
# OUTBOUND_VOICE_STUB_AUTO_COMPLETE=false
# OUTBOUND_VOICE_STUB_OUTCOME_KEY=NO_ANSWER
# Public base URL of this API for outbound create-call callback hints (gateway posts events to /integrations/outbound-voice/webhook). Overrides IntegrationSetting publicWebhookBaseUrl when set.
# OUTBOUND_VOICE_PUBLIC_BASE_URL=https://api.crm.example.com
# Optional default catalog link for sendCatalogToContact when IntegrationSetting catalogDefaults is empty.
# OUTBOUND_CATALOG_PUBLIC_URL=https://store.example.com/catalog
# Delayed Call linking (cron every 5 min when CRON_ENABLED=true): phone + time window ± minutes around attempt.updatedAt, optional contact/lead match. Safe mode skips ambiguity.
# OUTBOUND_CALL_LINK_WINDOW_MINUTES=90
# OUTBOUND_LINK_RECONCILE_BATCH=50
# OUTBOUND_LINK_RECONCILE_MAX_AGE_HOURS=72
# OUTBOUND_LINK_RECONCILE_PROVIDER=RINGOSTAT

# Store (internet shop): ownerId for orders from store. Run seed and copy id from log "STORE_OWNER_ID for .env"
# STORE_OWNER_ID=
# Optional fallback: FOP for new store orders only if not set in CRM → Settings → ФОП → «для магазину».
# STORE_DEFAULT_BANK_ACCOUNT_ID=

# CORS (production): comma-separated browser Origins that call the API (no spaces). Example:
# CORS_ORIGIN=https://crm.example.com,https://www.example.com,https://example.com
# If apex only 301-redirects to www, typical Origin is www; including apex is harmless.

NP_API_URL=https://api.novaposhta.ua/v2.0/json/
NP_API_KEY=xxxxx
# Таймаут запроса к НП (мс). При повільному інтернеті або Connect Timeout збільште, напр. 60000
# NP_API_TIMEOUT_MS=30000

# Sender (Dnipro, WH 75)
NP_SENDER_CITY_REF=xxxxxx
#NP_SENDER_COUNTERPARTY_REF="10000000000000000000000000000000"
#NP_SENDER_CONTACT_REF="10000000000000000000000000000000"
NP_SENDER_WAREHOUSE_REF=xxxxxx

# данные отправителя (для Counterparty/ContactPerson)
NP_SENDER_FIRST_NAME=xxxx
NP_SENDER_LAST_NAME=xxxx
NP_SENDER_PHONE=xxxx

# defaults
NP_DEFAULT_PAYER_TYPE=Recipient
NP_DEFAULT_PAYMENT_METHOD=Cash

# Privat24 Business API (bank sync). Optional; default https://api.privatbank.ua
# PRIVAT24_API_URL=https://api.privatbank.ua

# UPC Open Banking (int.upc)
# UPC_API_BASE_URL=https://portal.preprod.api.upc.ua
# UPC_CLIENT_ID=
# UPC_REDIRECT_URI=
# UPC_CERT_PATH=
# UPC_KEY_PATH=
# UPC_API_MOCK=true

# Telegram bot (Inbox integration)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Store: bot username for "link Telegram" deep link (e.g. MyShopBot)
# STORE_TELEGRAM_BOT_USERNAME=
# Optional: company for new leads from Telegram (default: first company)
# TELEGRAM_LEAD_COMPANY_ID=

# Telegram Inbox AI (suggest replies). Optional; can set in Settings → Telegram instead.
# OPENAI_API_KEY=

# Bitrix migration & sync (initial import from MySQL, delta via REST)
# When import runs from another host (e.g. 159.159.31.153), set BITRIX_MYSQL_HOST to the Bitrix server IP (e.g. 144.76.233.11) if MySQL is reachable; or use SSH tunnel (BITRIX_MYSQL_HOST=127.0.0.1, BITRIX_MYSQL_PORT=3307 with tunnel -L 3307:127.0.0.1:3306).
# BITRIX_MYSQL_HOST=localhost
# BITRIX_MYSQL_PORT=3306
# BITRIX_MYSQL_USER=
# BITRIX_MYSQL_PASSWORD=
# BITRIX_MYSQL_DATABASE=bitrix
# Connection timeout in ms (default 60000). Increase if using slow SSH tunnel.
# BITRIX_MYSQL_CONNECT_TIMEOUT_MS=60000
# BITRIX_WEBHOOK_URL=https://your-portal.bitrix24.com/rest/1/webhook_code/
# BITRIX_SYNC_ENABLED=false
# Bulk initial import: batch size (default 1000), max concurrent batches per entity (default 4)
# BITRIX_IMPORT_BATCH_SIZE=1000
# BITRIX_IMPORT_CONCURRENCY=4
# BITRIX_IMPORT_ORDER_TX_TIMEOUT_MS=60000
# Import only users with UF_DEPARTMENT set (employees). Set to false to import all b_user rows.
# BITRIX_IMPORT_EMPLOYEES_ONLY=true

# Bitrix live webhook sync (optional; works alongside cron delta sync)
# BITRIX_WEBHOOK_ENABLED=true
# BITRIX_WEBHOOK_SECRET=your_secret_token
# Bitrix sends this in header: x-bitrix-webhook-secret

# Product images sync from Google Drive (optional)
# Google Drive product images — prefer Settings → Google-таблиця (driveFolderId + serviceAccountJson).
# Env below is optional fallback for compose / local dev:
# GOOGLE_DRIVE_FOLDER_ID=your_folder_id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Meta (Facebook) Pixel — optional fallback if not set in CRM → Settings → Facebook / Meta Lead Ads
# FB_PIXEL_ID=1234567890123456

# Meta Lead Ads webhook: same URL for GET (verify) and POST — https://<API_HOST>/leads/meta/ingest
# META_APP_SECRET=              # App Secret from Meta App → Settings → Basic; required to verify X-Hub-Signature-256 in production
# META_WEBHOOK_VERIFY_TOKEN=    # Optional fallback if verify token is not stored in CRM → Settings → Meta
# META_GRAPH_API_VERSION=v21.0  # Graph API version for fetching lead field_data when webhook has no fields
# META_LEAD_COMPANY_ID=         # Company for new leads (optional if set in Settings → Meta or first company exists)
# LEAD_COMPANY_ID=              # Default CRM company for manually created leads (before first-company fallback)

# Release metadata (optional; surfaced to ADMIN via GET /system/release). Prefer CI/build args for Docker images.
# CRM_RELEASE_VERSION=1.0.0
# GIT_SHA=abc1234
# BUILD_TIME=2026-04-10T12:00:00Z
# IMAGE_TAG=crm-backend:1.0.0

# Expo Push API access token (optional; recommended for production mobile push)
# EXPO_ACCESS_TOKEN=

# In-product update flow (optional). Host-side agent: scripts/updater/agent.mjs
# Local dev: http://127.0.0.1:7788 — Docker backend on Mac: http://host.docker.internal:7788
# UPDATER_AGENT_URL=http://127.0.0.1:7788
# UPDATER_AGENT_TOKEN=
# AUTO_UPDATE_ENABLED=true
# AUTO_UPDATE_CRON=*/15 * * * *
# CONTROL_PLANE_UPDATE_STATUS_URL=

# Visit routing (OSRM sidecar — compose.client.yml / docker-compose.prod.yml)
# OSRM_BASE_URL=http://osrm:5000
# ROUTING_PROFILE=car
# OSRM_DATA_HOST=/opt/crm/osrm-data
