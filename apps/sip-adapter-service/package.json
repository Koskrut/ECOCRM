{
  "name": "sip-adapter-service",
  "version": "1.0.0",
  "private": true,
  "description": "SIP/FreeSWITCH B2B adapter for CRM gateway outbound calls",
  "main": "dist/main.js",
  "scripts": {
    "dev": "ts-node -r dotenv/config src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "node --test --require ts-node/register/transpile-only src/calls/call-store.spec.ts src/freeswitch/dial-string.util.spec.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.12",
    "@nestjs/core": "^11.1.12",
    "@nestjs/platform-express": "^11.1.12",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "dotenv": "^17.2.3",
    "modesl": "^1.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
